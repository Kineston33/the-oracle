{
  "name": "the-oracle",
  "version": "0.1.0",
  "description": "THE ORACLE — a forecasting intelligence platform to explore the future, discover emerging signals, and read the public archive of official predictions.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kineston33/the-oracle.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && tsc -b && vite build && npm run build:server",
    "build:server": "vite build --ssr src/server/index.ts --outDir build/server",
    "start": "node build/server/index.js",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p tsconfig.audit.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seal": "npm run validate && node scripts/seal-records.mjs",
    "validate": "node scripts/validate-archive.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "lucide-react": "^1.77.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "optionalDependencies": {
    "@embedded-postgres/linux-x64": "^16.16.0-beta.19"
  }
}
